{
  "name": "daily-music",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "daily-music": "./dist/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "poster": "tsx src/cli.ts",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:@napi-rs/canvas --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/cli.js",
    "build": "tsc --noEmit && vite build && npm run build:cli",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.8",
    "@mdi/js": "^7.4.47",
    "@napi-rs/canvas": "^1.0.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
